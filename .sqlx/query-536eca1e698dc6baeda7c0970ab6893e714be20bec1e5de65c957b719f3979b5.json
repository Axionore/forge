  "query": "\n            SELECT \n                id,\n                job_type,\n                success,\n                error,\n                started_at,\n                finished_at,\n                details,\n                received_at\n            FROM job_results\n            WHERE deployment_id = $1\n            ORDER BY received_at DESC\n            LIMIT $2\n            ",
