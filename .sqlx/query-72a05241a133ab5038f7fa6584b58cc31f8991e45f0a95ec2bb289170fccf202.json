{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT d.id, d.application_id, d.version, d.spec, d.status, d.strategy, d.previous_spec, d.rollout_state, d.created_at, d.updated_at\n            FROM deployments d\n            JOIN applications a ON d.application_id = a.id\n            WHERE a.name = $1\n            ORDER BY d.version DESC\n            LIMIT 1\n            ",
