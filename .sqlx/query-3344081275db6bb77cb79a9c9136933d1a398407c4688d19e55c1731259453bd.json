{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, rule_id, scope, target_id, metric_name, observed_value,\n                   severity, state, fired_at, resolved_at, notified\n            FROM alert_events\n            WHERE ($1::text IS NULL OR state = $1)\n              AND ($2::text IS NULL OR severity = $2)\n            ORDER BY fired_at DESC\n            LIMIT $3\n            ",
